[Unit]
Description=Cerro WCN7850 Bluetooth (uart14)
After=local-fs.target cerro-usb-acm.service bluetooth.service
Wants=cerro-usb-acm.service bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cerro-bt-up.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
